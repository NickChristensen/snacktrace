{
  "name": "snacktrace",
  "version": "2.0.0",
  "description": "Read-only FoodNoms HTTP API",
  "license": "ISC",
  "type": "module",
  "engines": {"node": ">=24"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js --extension ts \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "openapi:generate": "tsx src/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && redocly lint openapi.json && git diff --exit-code -- openapi.json"
  },
  "dependencies": {
    "@fastify/swagger": "^9.6.0",
    "@sinclair/typebox": "^0.34.33",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.6.2",
    "kysely": "^0.28.17"
  },
  "devDependencies": {
    "@redocly/cli": "^2.18.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/node": "^24.10.1",
    "chai": "^5.3.3",
    "eslint": "^9.39.1",
    "mocha": "^11.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
